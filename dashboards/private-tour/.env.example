# Supabase 数据平台 project(与 webuy-tracking-system 同一个)。
# 两个值都在 Supabase → Project Settings → API;anon key 只配合 RLS + 函数白名单使用。
# 本地放 .env.local(已 gitignore),线上配在 Vercel → Project → Settings → Environment Variables。
# 两个都不填 = 示例数据模式(不连库、不需要登录)。
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 登录邮件里的回跳地址,例如 https://pt-dashboard.internal.webuy.global
NEXT_PUBLIC_SITE_URL=
